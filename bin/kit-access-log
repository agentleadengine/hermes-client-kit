#!/usr/bin/env bash
set -euo pipefail

report=/var/lib/hermes-kit/access-log.txt
since=${2:-}
[[ ${1:-} == --since || -z ${1:-} ]] || { echo 'Usage: kit-access-log [--since DURATION]' >&2; exit 2; }
[[ ${1:-} != --since || -n $since ]] || { echo 'Usage: kit-access-log [--since DURATION]' >&2; exit 2; }
if [[ ${EUID} -eq 0 ]]; then
  # Hermes needs only traversal to this directory and read access to this
  # generated public metadata file.  It cannot list or read health/grant state.
  install -d -m 0751 -o root -g root /var/lib/hermes-kit
  { journalctl --no-pager -u ssh -u sshd -t sudo 2>/dev/null || true; [[ -f /var/log/auth.log ]] && grep -E 'sshd.*Accepted|sudo:' /var/log/auth.log || true; [[ -f /var/lib/hermes-kit/access-events.log ]] && cat /var/lib/hermes-kit/access-events.log; } | sort -u > "$report"
  chown root:root "$report"
  chmod 0644 "$report"
fi
[[ -f $report ]] || { echo 'Access-log timer has not produced its first report yet.' >&2; exit 1; }
if [[ -z $since ]]; then cat "$report"; exit 0; fi
cutoff=$(date -u -d "$since ago" +%s 2>/dev/null) || { echo 'Invalid --since duration.' >&2; exit 2; }
# Do not append the unfiltered cached report. Journal is filtered at source;
# grant and handover events carry UTC timestamps and are filtered before print.
journalctl --since "$since ago" --no-pager -u ssh -u sshd -t sudo 2>/dev/null || true
if [[ -f /var/lib/hermes-kit/access-events.log ]]; then
  while IFS= read -r line; do
    stamp=${line%% *}
    event_epoch=$(date -u -d "$stamp" +%s 2>/dev/null || printf 0)
    (( event_epoch >= cutoff )) && printf '%s\n' "$line"
  done < /var/lib/hermes-kit/access-events.log
fi
