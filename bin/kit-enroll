#!/usr/bin/env bash
set -euo pipefail

[[ ${EUID} -eq 0 || ${KIT_ENROLL_TEST_MODE:-} == 1 ]] || { echo 'kit-enroll must run as root.' >&2; exit 1; }
[[ $# -eq 0 || ( $# -eq 1 && $1 == --reset ) ]] || { echo 'Usage: kit-enroll [--reset]' >&2; exit 2; }
script_path=$(readlink -f "${BASH_SOURCE[0]}")
kit_dir=$(cd -- "$(dirname -- "$script_path")/.." && pwd)
# shellcheck source=../lib/common.sh
source "$kit_dir/lib/common.sh"
# shellcheck source=../lib/report-common.sh
source "$kit_dir/lib/report-common.sh"
report_key_file=${KIT_REPORT_KEY_FILE:-/etc/hermes-kit/report/box_ed25519.pem}
report_state_dir=${KIT_REPORT_STATE_DIR:-/var/lib/hermes-kit/report}
config=${KIT_CONFIG:-/etc/hermes-kit/kit.conf}
load_kit_config "$config"
[[ ${KIT_AGENT_ID:-} =~ ^A[0-9]{2,4}$ && ${KIT_HQ_URL:-} == https://* ]] || { echo 'Enrollment configuration is incomplete.' >&2; exit 1; }
if [[ ${1:-} != --reset && -f $report_state_dir/enrolled-agent-id && -f $report_key_file ]]; then
  [[ $(<"$report_state_dir/enrolled-agent-id") == "$KIT_AGENT_ID" && -z ${KIT_ENROLL_CODE:-} ]] || { echo 'Enrollment state conflicts with kit configuration; use --reset with a reminted code.' >&2; exit 1; }
  [[ ${KIT_ENROLL_TEST_MODE:-} == 1 || $(stat -c '%U:%G:%a' "$report_key_file") == root:root:600 ]] || { echo 'Box key permissions are invalid.' >&2; exit 1; }
  systemctl enable --now hermes-kit-report.timer
  report_words "$(report_pub_b64)" "$kit_dir/contract/fingerprint-words.txt"
  exit 0
fi
[[ -n ${KIT_ENROLL_CODE:-} ]] || { echo 'Enrollment code is missing.' >&2; exit 1; }
install -d -m 0700 "$(dirname "$report_key_file")"
canonical_key=$report_key_file
new_key=''
tmp=''
tmp_config=''
tmp_body=''
tmp_code=''
trap 'rm -f -- "$new_key" "$tmp" "$tmp_config" "$tmp_body" "$tmp_code"' EXIT
if [[ ${1:-} == --reset ]]; then
  new_key=$(mktemp "$(dirname "$canonical_key")/.box-key.XXXXXX")
  report_key_file=$new_key
fi
umask 077
if [[ ! -f $report_key_file || -n $new_key ]]; then openssl genpkey -algorithm ED25519 -out "$report_key_file" >/dev/null 2>&1; fi
chmod 0600 "$report_key_file"
[[ ${KIT_ENROLL_TEST_MODE:-} == 1 || $(stat -c '%U:%G:%a' "$report_key_file") == root:root:600 ]] || { echo 'Box key permissions are invalid.' >&2; exit 1; }
pub_b64=$(report_pub_b64)
words=$(report_words "$pub_b64" "$kit_dir/contract/fingerprint-words.txt")
ts=$(date -u +%FT%TZ)
tmp=$(mktemp)
printf 'enroll|%s|%s|%s|%s' "$KIT_AGENT_ID" "$pub_b64" "$ts" "$KIT_ENROLL_CODE" > "$tmp"
sig_b64=$(report_sign_b64 "$tmp")
tmp_body=$(mktemp)
tmp_code=$(mktemp)
printf '%s' "$KIT_ENROLL_CODE" > "$tmp_code"
jq -nc --arg agent_id "$KIT_AGENT_ID" --arg pub_b64 "$pub_b64" --arg ts "$ts" --rawfile code "$tmp_code" --arg sig_b64 "$sig_b64" '{v:1,agent_id:$agent_id,pub_b64:$pub_b64,ts:$ts,code:$code,sig_b64:$sig_b64}' > "$tmp_body"
response=$(curl --fail --silent --show-error --max-time 10 --retry 6 --retry-all-errors --retry-delay 5 --retry-max-time 300 --header 'Content-Type: application/json' --data-binary @"$tmp_body" "${KIT_HQ_URL%/}/api/enroll")
server_words=$(jq -er 'select(.ok == true) | .words | strings' <<<"$response")
[[ $server_words == "$words" ]] || { echo 'HQ fingerprint words do not match this box.' >&2; exit 1; }
if [[ -n $new_key ]]; then mv -f "$new_key" "$canonical_key"; new_key=''; fi
tmp_config=$(mktemp "$(dirname "$config")/.kit.conf.XXXXXX")
awk '!/^KIT_ENROLL_CODE=/' "$config" > "$tmp_config"
chmod --reference="$config" "$tmp_config"
chown --reference="$config" "$tmp_config"
mv "$tmp_config" "$config"
install -d -m 0700 "$report_state_dir"
printf '%s\n' "$KIT_AGENT_ID" > "$report_state_dir/enrolled-agent-id"
chmod 0600 "$report_state_dir/enrolled-agent-id"
systemctl enable --now hermes-kit-report.timer
printf '%s\n' "$words"
