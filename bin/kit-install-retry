#!/usr/bin/env bash
set -euo pipefail

[[ ${EUID} -eq 0 || ${KIT_INSTALL_RETRY_TEST_MODE:-} == 1 ]] || { echo 'kit-install-retry must run as root.' >&2; exit 1; }
kit_dir=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
state=${KIT_INSTALL_RETRY_STATE_DIR:-/var/lib/hermes-kit/install-retry}
install -d -m 0700 "$state"
exec 9>"$state/lock"
if [[ ${KIT_INSTALL_RETRY_TEST_MODE:-} != 1 ]]; then flock 9; fi

[[ -f $state/succeeded || -f $state/failed ]] && exit 0
attempts=$(cat "$state/attempts" 2>/dev/null || printf 0)
[[ $attempts =~ ^[0-3]$ ]] || { echo 'Invalid installation retry state.' >&2; exit 1; }
if (( attempts >= 3 )); then exit 1; fi
attempts=$((attempts + 1))
printf '%s\n' "$attempts" > "$state/attempts"
chmod 0600 "$state/attempts"
if KIT_INSTALL_RETRY_ACTIVE=1 "${KIT_INSTALL_RETRY_INSTALL_COMMAND:-$kit_dir/install.sh}"; then
  : > "$state/succeeded"
  chmod 0600 "$state/succeeded"
  if [[ ${KIT_INSTALL_RETRY_TEST_MODE:-} != 1 ]]; then systemctl disable --now hermes-kit-install-retry.timer; fi
  exit 0
fi
if (( attempts < 3 )); then
  printf 'Hermes Kit installation attempt %s of 3 failed; next attempt in 10 minutes.\n' "$attempts" >&2
  exit 0
fi
: > "$state/failed"
chmod 0600 "$state/failed"
"${KIT_INSTALL_RETRY_REPORT_COMMAND:-$kit_dir/bin/kit-install-report}" --failed || true
if [[ ${KIT_INSTALL_RETRY_TEST_MODE:-} != 1 ]]; then systemctl disable --now hermes-kit-install-retry.timer; fi
echo 'Hermes Kit installation failed after three attempts.' >&2
exit 1
