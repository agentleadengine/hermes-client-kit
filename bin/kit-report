#!/usr/bin/env bash
set -euo pipefail
[[ $# -eq 0 || ( $# -eq 1 && $1 == --shutdown ) ]] || { echo 'Usage: kit-report [--shutdown]' >&2; exit 2; }
[[ ${EUID} -eq 0 ]] || { echo 'kit-report must run as root.' >&2; exit 1; }
script_path=$(readlink -f "${BASH_SOURCE[0]}")
kit_dir=$(cd -- "$(dirname -- "$script_path")/.." && pwd)
# shellcheck source=../lib/common.sh
source "$kit_dir/lib/common.sh"
# shellcheck source=../lib/report-common.sh
source "$kit_dir/lib/report-common.sh"
report_key_file=${KIT_REPORT_KEY_FILE:-/etc/hermes-kit/report/box_ed25519.pem}
report_state_dir=${KIT_REPORT_STATE_DIR:-/var/lib/hermes-kit/report}
config=${KIT_CONFIG:-/etc/hermes-kit/kit.conf}
[[ -f $config ]] || exit 0
load_kit_config "$config"
[[ ${KIT_AGENT_ID:-} =~ ^A[0-9]{2,4}$ && ${KIT_HQ_URL:-} == https://* && -f $report_key_file && -f $report_state_dir/enrolled-agent-id ]] || exit 0
[[ $(<"$report_state_dir/enrolled-agent-id") == "$KIT_AGENT_ID" ]] || exit 0
install -d -m 0700 "$report_state_dir"
exec 9>"$report_state_dir/lock"
flock -n 9 || exit 0
failures_file="$report_state_dir/failures_since_last_ok"
failures=$(cat "$failures_file" 2>/dev/null || printf 0)
[[ $failures =~ ^[0-9]+$ ]] || failures=0
record_failure() {
  printf '%s\n' "$(( failures + 1 ))" > "$failures_file"
  chmod 0600 "$failures_file"
}
health_file=${KIT_HEALTH_FILE:-/var/lib/hermes-kit/health.json}
[[ -f $health_file ]] || { record_failure; exit 0; }
tmp=$(mktemp -d "$report_state_dir/.send.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
if [[ ${1:-} == --shutdown ]]; then
  jq --argjson failures "$failures" '.going_down = true | .push.failures_since_last_ok = $failures' "$health_file" > "$tmp/payload.json" || { record_failure; exit 0; }
else
  jq --argjson failures "$failures" '.push.failures_since_last_ok = $failures' "$health_file" > "$tmp/payload.json" || { record_failure; exit 0; }
fi
if ! jq -e --arg agent_id "$KIT_AGENT_ID" '.schema == 3 and .agent_id == $agent_id' "$tmp/payload.json" >/dev/null; then record_failure; exit 0; fi
nonce=$(openssl rand -hex 16) || { record_failure; exit 0; }
sent_at=$(date -u +%FT%TZ)
jq -c --arg agent_id "$KIT_AGENT_ID" --arg sent_at "$sent_at" --arg nonce "$nonce" --slurpfile payload "$tmp/payload.json" \
  -n '{v:1,agent_id:$agent_id,sent_at:$sent_at,nonce:$nonce,payload:$payload[0]}' > "$tmp/body.json"
sig_b64=$(report_sign_b64 "$tmp/body.json") || { record_failure; exit 0; }
if curl --fail --silent --show-error --max-time 10 --retry 6 --retry-all-errors --retry-delay 5 --retry-max-time 30 --header 'Content-Type: application/json' \
  --header "X-AC-Agent: $KIT_AGENT_ID" --header "X-AC-Signature: $sig_b64" \
  --data-binary @"$tmp/body.json" "${KIT_HQ_URL%/}/api/ingest" > /dev/null 2>&1; then
  printf '0\n' > "$failures_file"
  chmod 0600 "$failures_file"
  exit 0
fi
record_failure
exit 0
