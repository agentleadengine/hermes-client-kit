support_effective_json_is() {
  local path=$1 expected=$2 actual canonical_expected
  actual=$(runuser -u hermes-support -- env HOME=/var/lib/hermes-support HERMES_HOME=/var/lib/hermes-support PATH=/opt/hermes-support-runtime/current/bin:/usr/local/bin:/usr/bin:/bin \
    "$support_hermes" config get "$path" --json 2>/dev/null | canonical_json || true)
  canonical_expected=$(printf '%s' "$expected" | canonical_json || true)
  [[ -n $actual && $actual == "$canonical_expected" ]]
}
if [[ -x $support_hermes && -f /var/lib/hermes-support/config.yaml ]] && support_effective_json_is agent.disabled_toolsets "$support_disabled" && support_effective_json_is platform_toolsets.cli "$support_tools"; then
  support_policy=true
