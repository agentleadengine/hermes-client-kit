if [[ $tier == care || $tier == managed ]]; then
  if [[ ! -s /etc/hermes-kit/full/authorized_keys && ! -s /etc/ssh/kit-full.keys ]]; then pass 'CARE has no standing full key'; else fail 'CARE_FULL_ACCESS_KEY'; fi
  if ! id -u ops >/dev/null 2>&1 && ! id -u hermes-ops >/dev/null 2>&1 && { [[ $tier == managed ]] || ! id -u kit-manager >/dev/null 2>&1; }; then pass 'CARE has no operator Unix account'; else fail 'CARE_OPERATOR_ACCOUNT'; fi
  if [[ ! -e /etc/sudoers.d/90-hermes-kit-ops && ! -e /etc/sudoers.d/90-hermes-kit-hermes-ops && ! -e /etc/ssh/auth_principals/hermes-ops ]]; then pass 'CARE has no operator sudo or SSH principal'; else fail 'CARE_OPERATOR_PRINCIPAL'; fi
