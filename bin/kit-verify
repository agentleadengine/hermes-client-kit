  if ! systemctl is-active --quiet hermes-kit-grant-cleanup.timer; then pass 'CARE grant expiry timer is inactive'; else fail 'CARE_GRANT_TIMER'; fi
  if [[ $tier == managed ]]; then
    if [[ -s /etc/hermes-kit/manager/authorized_keys && -s /etc/ssh/kit-manager.keys ]] && cmp -s /etc/hermes-kit/manager/authorized_keys /etc/ssh/kit-manager.keys; then
      pass 'MANAGED manager key present'
    manager_policy=$(sshd -T -C user=kit-manager,host=localhost,addr=127.0.0.1 2>/dev/null || true)
    if grep -Fqx 'forcecommand /usr/local/sbin/kit-manage-dispatch' <<<"$manager_policy" && grep -Fqx 'permittty no' <<<"$manager_policy" && grep -Fqx 'allowtcpforwarding no' <<<"$manager_policy" && grep -Fqx 'allowagentforwarding no' <<<"$manager_policy"; then pass 'MANAGED ForceCommand and SSH restrictions'; else fail 'MANAGED_SSH_POLICY'; fi
    manager_probe=true
    private_paths=("$hermes_home/memories" "$hermes_home/sessions" "$hermes_home/state.db" /home/hermes/vault "$hermes_home/.env" "$hermes_home/auth.json" "$hermes_root/auth.json")
