    for private in "${private_paths[@]}"; do
      if [[ -d $private ]]; then
        canary=$(mktemp "$private/.kit-manager-canary.XXXXXX")
        printf 'manager-read-refused\n' > "$canary"
        chmod 0644 "$canary"
        if runuser -u kit-manager -- test -r "$canary"; then manager_probe=false; fi
        rm -f "$canary"
      elif [[ -f $private ]]; then
        if runuser -u kit-manager -- test -r "$private"; then manager_probe=false; fi
      elif [[ -d $(dirname "$private") ]]; then
        canary=$(mktemp "$(dirname "$private")/.kit-manager-canary.XXXXXX")
        printf 'manager-read-refused\n' > "$canary"
        chmod 0644 "$canary"
        if runuser -u kit-manager -- test -r "$canary"; then manager_probe=false; fi
        rm -f "$canary"
      fi
    done
    if runuser -u kit-manager -- test -r /srv/tools/data; then manager_probe=false; fi
    if [[ $manager_probe == true ]]; then pass 'MANAGED private data unreadable'; else fail 'MANAGED_PRIVATE_DATA'; fi
    if runuser -u kit-manager -- env SSH_ORIGINAL_COMMAND='cat /etc/hermes-kit/kit.conf' /usr/local/sbin/kit-manage-dispatch >/dev/null 2>&1; then fail 'MANAGED_NON_MENU_REFUSED'; else pass 'MANAGED non-menu command refused'; fi
    elif [[ ! -s /etc/hermes-kit/manager/authorized_keys && ! -s /etc/ssh/kit-manager.keys ]]; then
      pass 'MANAGED has no standing manager key yet'
    else
      fail 'MANAGED_MANAGER_KEY'
    fi
  elif [[ ! -e /etc/hermes-kit/manager/authorized_keys ]]; then pass 'CARE has no manager key'; else fail 'CARE_MANAGER_KEY'; fi
else
  ludicrous_valid=true
  id -u hermes-ops >/dev/null 2>&1 || ludicrous_valid=false
  [[ -f /etc/sudoers.d/90-hermes-kit-hermes-ops && -f /etc/ssh/auth_principals/hermes-ops && -f /etc/ssh/sshd_config.d/10-hermes-kit-access.conf && -f /etc/tlog/tlog-rec-session.conf ]] || ludicrous_valid=false
  if [[ ! -s /etc/hermes-kit/full/authorized_keys ]]; then
    [[ -s /var/lib/hermes-kit/grants/ledger.tsv ]] || ludicrous_valid=false
    systemctl is-active --quiet hermes-kit-grant-cleanup.timer || ludicrous_valid=false
  fi
  sshd_effective_ops=$(sshd -T -C user=hermes-ops,host=localhost,addr=127.0.0.1 2>/dev/null || true)
  grep -Fqx 'trustedusercakeys /etc/ssh/kit/client-ca.pub' <<<"$sshd_effective_ops" >/dev/null || ludicrous_valid=false
  grep -Fqx 'authorizedprincipalsfile /etc/ssh/auth_principals/%u' <<<"$sshd_effective_ops" >/dev/null || ludicrous_valid=false
  if [[ -s /etc/hermes-kit/full/authorized_keys ]]; then
    grep -Fqx 'authorizedkeysfile /etc/ssh/kit-full.keys' <<<"$sshd_effective_ops" >/dev/null || ludicrous_valid=false
  else
    grep -Fqx 'authorizedkeysfile none' <<<"$sshd_effective_ops" >/dev/null || ludicrous_valid=false
  fi
  grep -Fqx 'revokedkeys /etc/ssh/kit/revoked.krl' <<<"$sshd_effective_ops" >/dev/null || ludicrous_valid=false
  active_certificates=0
  now_epoch=$(date -u +%s)
  for certificate in /var/lib/hermes-kit/grants/*-cert.pub; do
    [[ -f $certificate ]] || continue
    active_certificates=$((active_certificates + 1))
    grant_id=${certificate##*/}; grant_id=${grant_id%-cert.pub}
    ledger_row=$(awk -F $'\t' -v grant="$grant_id" '$2 == grant {print; exit}' /var/lib/hermes-kit/grants/ledger.tsv)
    [[ -n $ledger_row ]] || ludicrous_valid=false
    IFS=$'\t' read -r serial ledger_grant expiry waiver fingerprint <<<"$ledger_row"
    [[ $ledger_grant == "$grant_id" && -n $fingerprint ]] || ludicrous_valid=false
    expiry_epoch=$(date -u -d "${expiry:-invalid}" +%s 2>/dev/null || printf 0)
    [[ $serial =~ ^[1-9][0-9]*$ && -n ${waiver:-} && $expiry_epoch -gt $now_epoch ]] || ludicrous_valid=false
    ssh-keygen -Lf "$certificate" | grep -A1 '^        Principals:' | grep -Fx '                ops' >/dev/null || ludicrous_valid=false
    # Zero means unrevoked for ssh-keygen -Q. Any other state is invalid.
    ssh-keygen -Q -f /etc/ssh/kit/revoked.krl "$certificate" >/dev/null 2>&1 || ludicrous_valid=false
  done
  (( active_certificates > 0 )) || [[ -s /etc/hermes-kit/full/authorized_keys ]] || ludicrous_valid=false
  [[ $ludicrous_valid == true ]] && pass 'LUDICROUS_BOUNDED_ACCESS' || fail 'LUDICROUS_BOUNDED_ACCESS'
fi
no_known_secret_patterns() {
  python3 - /etc/hermes "$hermes_home"/SOUL.md "$hermes_home"/config.yaml "$hermes_home"/mcp.json "$hermes_home"/distribution.yaml "$hermes_home"/skills <<'PY'
from pathlib import Path
import re
import sys

openai_key = re.compile(r'\bsk-[A-Za-z0-9_-]{16,}\b')
google_key = re.compile(r'\bAIza[A-Za-z0-9_-]{20,}\b')
telegram_token = re.compile(r'(?m)^\s*(?:export\s+)?TELEGRAM_BOT_TOKEN\s*=\s*["\']?([0-9]{5,}:[A-Za-z0-9_-]{20,})')

def is_placeholder(token: str, prefix: str) -> bool:
    body = token[len(prefix):]
    return bool(body) and all(character.lower() == 'x' for character in body)

for root_name in sys.argv[1:]:
    root = Path(root_name)
    paths = root.rglob('*') if root.is_dir() else (root,)
    for path in paths:
        if not path.is_file():
            continue
        try:
            text = path.read_text(encoding='utf-8')
        except (OSError, UnicodeDecodeError):
            continue
        if any(not is_placeholder(match.group(), 'sk-') for match in openai_key.finditer(text)):
            sys.exit(1)
        if any(not is_placeholder(match.group(), 'AIza') for match in google_key.finditer(text)):
            sys.exit(1)
        if telegram_token.search(text):
            sys.exit(1)
sys.exit(0)
PY
}
if no_known_secret_patterns; then pass 'no known secret patterns in managed or client profile files'; else fail 'no known secret patterns in managed or client profile files'; fi

if [[ $json_mode == true ]]; then
  printf '%s\n' "${results[@]}" | jq -R 'split("\t") | select((length == 2) and (.[0] | IN("PASS","FAIL","WARN")))' | jq -sc --argjson failures "$failures" --argjson warnings "$warns" '{checks: map({status:.[0],id:.[1]}),failures:$failures,warnings:$warnings}'
else
  printf 'Summary: %s failure(s), %s warning(s)\n' "$failures" "$warns"
fi
(( failures == 0 ))
